# Forge AI - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit raw keys or .env files to public or remote repositories.

# Supabase Cloud Telemetry Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Hardware Bridge & Comms Settings (WebSerial / Sneakernet)
DEFAULT_BAUD_RATE=921600
I2S_SAMPLING_RATE_HZ=48000
FFT_WINDOW_SIZE=2048
ACOUSTIC_BANDS_COUNT=80
