{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/registry/main/schema/server.schema.json",
  "name": "io.github.thealidev/forgeai",
  "version": "2.0.0",
  "description": "Forge AI: Autonomous acoustic CNC spindle defense, sub-15ms optical feed-hold, and secure industrial physical-AI execution gateway.",
  "author": "Raja Muhammad Ali Asghar",
  "icon": "🛡️",
  "repository": "https://github.com/RMAAPK/ForgeAI",
  "license": "BSL-1.1",
  "tags": [
    "industrial",
    "manufacturing",
    "cnc",
    "hardware",
    "esp32",
    "acoustic-dsp",
    "safety",
    "sandbox"
  ],
  "transport": {
    "type": "sse",
    "url": "http://localhost:3000/sse"
  },
  "commands": {
    "docker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-p",
        "3000:3000",
        "--cap-drop",
        "ALL",
        "ghcr.io/rmaapk/forgeai:latest"
      ]
    },
    "npx": {
      "command": "npx",
      "args": [
        "-y",
        "forgeai-core@latest"
      ]
    }
  }
}
